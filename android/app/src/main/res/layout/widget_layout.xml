<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="20dp">
    <!-- RelativeLayout centers without its own padding, so the bottom offset sits on this parent -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <!-- At most 130x65dp, shrinks keeping 2:1 when the launcher cell is narrower -->
        <ImageView
            android:id="@+id/widget_frame"
            android:src="@drawable/widget_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
        />
        <ImageView
            android:id="@+id/widget_background"
            android:src="@drawable/hw_background"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/widget_frame"
            android:layout_alignTop="@id/widget_frame"
            android:layout_alignEnd="@id/widget_frame"
            android:layout_alignBottom="@id/widget_frame"
            android:scaleType="fitXY"
        />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/widget_frame"
            android:layout_alignTop="@id/widget_frame"
            android:layout_alignEnd="@id/widget_frame"
            android:layout_alignBottom="@id/widget_frame"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/widget_settings"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="4dp"
                />
                <ImageView
                    android:id="@+id/widget_otp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="5dp"
                    android:scaleType="fitStart"
                />
            </LinearLayout>
            <ImageView
                android:id="@+id/widget_action"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
            />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
